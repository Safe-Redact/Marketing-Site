{
  "name": "saferedact-service-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run content:validate",
    "dev": "next dev",
    "predev:https": "npm run content:validate",
    "dev:https": "node --env-file-if-exists=.env.local scripts/dev-https.mjs",
    "oauth:dev": "npm --prefix services/cms-oauth-broker run dev",
    "prebuild": "npm run content:validate",
    "build": "next build",
    "prestart": "npm run content:validate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cms:config": "node --env-file-if-exists=.env.local scripts/render-cms-config.mjs",
    "cms:config:test": "node scripts/render-cms-config.mjs --disabled",
    "content:validate": "tsx scripts/validate-content.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "images:product": "node scripts/build-product-images.mjs",
    "db:provision": "node --env-file-if-exists=.env.local scripts/provision-local-db.mjs",
    "comments:migrate": "node --env-file-if-exists=.env.local scripts/migrate-comments.mjs",
    "test": "npm run test:static && npm run test:content && npm run test:routes && npm run test:oauth",
    "test:static": "node --test tests/phase1-components.test.mjs tests/phase2-homepage.test.mjs tests/phase3-production.test.mjs tests/phase4a1-security.test.mjs tests/phase5-infrastructure.test.mjs tests/release-pipeline.test.mjs",
    "test:content": "tsx --env-file-if-exists=.env.local --test tests/chatwoot-integration.test.ts tests/comments-domain.test.ts tests/comments-moderation.test.ts tests/comments-postgres.test.ts tests/comments-routes.test.ts tests/contact-route.test.ts tests/csp-middleware.test.ts tests/lead-delivery.test.ts tests/openredakt-branding.test.ts tests/phase4a-content.test.ts tests/pricing-features.test.ts tests/publishing-lifecycle.test.ts tests/showcase-theme.test.ts",
    "test:routes": "node scripts/run-route-tests.mjs",
    "test:oauth": "npm --prefix services/cms-oauth-broker test",
    "release:package": "node scripts/release/package-release.mjs",
    "release:verify": "node scripts/release/verify-blue-green.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
