{
  "name": "saferedact-service-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run cms:config",
    "dev": "next dev",
    "predev:https": "npm run cms:config",
    "dev:https": "node --env-file-if-exists=.env.local scripts/dev-https.mjs",
    "oauth:dev": "npm --prefix services/cms-oauth-broker run dev",
    "prebuild": "npm run cms:config",
    "build": "next build",
    "prestart": "npm run cms:config",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cms:config": "node --env-file-if-exists=.env.local scripts/render-cms-config.mjs",
    "cms:config:test": "node scripts/render-cms-config.mjs --disabled",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pretest": "npm run cms:config:test",
    "test": "npm run test:static && npm run test:content && npm run test:routes && npm run test:oauth",
    "pretest:static": "npm run cms:config:test",
    "test:static": "node --test tests/phase1-components.test.mjs tests/phase2-homepage.test.mjs tests/phase3-production.test.mjs tests/phase4a1-security.test.mjs tests/phase5-infrastructure.test.mjs",
    "pretest:content": "npm run cms:config:test",
    "test:content": "tsx --test tests/contact-route.test.ts tests/phase4a-content.test.ts",
    "test:routes": "node scripts/run-route-tests.mjs",
    "test:oauth": "npm --prefix services/cms-oauth-broker test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
