# SafeRedact CMS OAuth broker — local development template.
# Copy to .env.local in this directory and edit. .env.local is git-ignored and must
# never be committed, pasted into a chat or ticket, or echoed to a terminal.
#
# Loaded only by `npm run dev` in this package (and `npm run oauth:dev` from the
# repository root) through Node's native --env-file-if-exists. The service source
# never reads env files: it reads process.env and nothing else, so the production
# deployment can inject these through a secret store unchanged.
#
# Startup is fail-closed. A missing or malformed value aborts before the listener
# opens, with a generic message that contains no configuration value.

# --- GitHub OAuth application ---
# Client ID is public (it appears in the browser's authorize URL by design).
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-client-id
# SECRET. Server-side only. Never rendered into public/admin/config.yml.
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# --- Exact origins and callback ---
# Broker's own HTTPS origin, including any non-default port. No path, no credentials.
OAUTH_PUBLIC_ORIGIN=https://localhost:8787
# Must equal OAUTH_PUBLIC_ORIGIN plus /callback, and match the OAuth application's
# single registered callback with wildcard matching disabled.
OAUTH_CALLBACK_URL=https://localhost:8787/callback
# Comma-separated exact HTTPS admin origins. Each must match PUBLIC_SITE_ORIGIN in
# the root env file byte for byte, including port. No globs, no HTTP, no duplicates.
OAUTH_ALLOWED_ORIGINS=https://localhost:3000

# --- Authorization ---
OAUTH_ALLOWED_REPOSITORY=Safe-Redact/Marketing-Site
# Comma-separated immutable numeric GitHub user IDs, not logins.
# Read one with: curl -s https://api.github.com/users/LOGIN
OAUTH_ALLOWED_GITHUB_USER_IDS=replace-with-numeric-staff-ids
OAUTH_GITHUB_SCOPE=public_repo

# --- State signing ---
# SECRET. Exactly 32 bytes, base64url (43 characters). Generate a fresh value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OAUTH_STATE_SECRET=replace-with-a-fresh-32-byte-base64url-key

# --- Transport ---
# Absolute paths to a locally trusted certificate and key, kept outside this
# repository. Paths only; no key material belongs in any env file.
OAUTH_TLS_CERT_PATH=replace-with-absolute-path-to-localhost-cert.pem
OAUTH_TLS_KEY_PATH=replace-with-absolute-path-to-localhost-key.pem
OAUTH_PORT=8787
OAUTH_BIND_HOST=127.0.0.1

# --- Optional hardening limits (defaults applied when unset) ---
# OAUTH_TRANSACTION_TTL_SECONDS=600
# OAUTH_MAX_PENDING_TRANSACTIONS=1024
# OAUTH_REQUEST_TIMEOUT_MS=5000
