# OpenRedakt marketing site — local development template.
# Copy to .env.local and edit. .env.local is git-ignored and must never be committed.
#
# This file holds PUBLIC deployment coordinates only. Every value here is rendered
# at request time by /admin/config.yml or passed to the dev server as a flag.
# OAuth credentials do NOT belong here — they live only in
# services/cms-oauth-broker/.env.local, which is read by the broker process.
#
# Loaded by `npm run cms:config` and `npm run dev:https` through Node's native
# --env-file-if-exists. Next.js reads the same file for the runtime configuration
# route. Variables already exported in the shell take precedence.

# --- Decap CMS configuration (scripts/render-cms-config.mjs) ---
# Set to false (or remove .env.local) to render the fail-closed .invalid profile.
CMS_ENABLED=true
# Exact HTTPS origin of the admin site, including port. Must appear byte-identically
# in OAUTH_ALLOWED_ORIGINS in the broker env file.
PUBLIC_SITE_ORIGIN=https://localhost:3000
# Exact HTTPS origin of the OAuth broker, including port.
CMS_OAUTH_PUBLIC_BASE_URL=https://localhost:8787
CMS_OAUTH_AUTH_ENDPOINT=auth
CMS_GITHUB_REPOSITORY=Safe-Redact/Marketing-Site
# Development acceptance uses the feature branch. The reviewed production deployment
# uses master only after required branch protection and the release workflow are active.
CMS_PUBLISH_BRANCH=replace-with-the-approved-publishing-branch
CMS_AUTH_SCOPE=public_repo

# --- Local HTTPS dev server (scripts/dev-https.mjs) ---
# Absolute paths to a locally trusted certificate and key, kept outside this
# repository. Paths only; no key material belongs in any env file.
DEV_HTTPS_CERT_PATH=replace-with-absolute-path-to-localhost-cert.pem
DEV_HTTPS_KEY_PATH=replace-with-absolute-path-to-localhost-key.pem
# Must match the port in PUBLIC_SITE_ORIGIN, or the launcher refuses to start.
DEV_HTTPS_PORT=3000

# --- Lead delivery (src/lib/leads) ---
# Number of reverse-proxy hops that overwrite or append X-Forwarded-For before the
# request reaches Next.js. Leave unset (secure default 0) until the chosen host's
# forwarding-header contract is verified. A typical single trusted proxy uses 1.
# TRUST_PROXY_HOPS=1
# All four must be set together, or the endpoint accepts enquiries without
# delivering them and says so honestly. Leave them unset to keep that behaviour.
# The transport speaks plain HTTPS and JSON with no vendor SDK; the payload shape
# ({from, to, subject, text}) is the one Resend accepts directly. A provider with a
# different shape gets its own file in src/lib/leads/transports.
# SECRET: the token belongs in .env.local or a secret store, never here.
LEAD_DELIVERY_ENDPOINT=replace-with-the-provider-https-endpoint
LEAD_DELIVERY_TOKEN=replace-with-the-provider-api-token
# A sender address on a domain the provider has verified.
LEAD_DELIVERY_FROM=replace-with-a-verified-sender-address
# The single internal mailbox that receives enquiries.
LEAD_DELIVERY_TO=replace-with-the-enquiries-mailbox
# Optional, 500 to 15000, default 5000.
# LEAD_DELIVERY_TIMEOUT_MS=5000

# --- Visitor comments (src/lib/comments) ---
# Plain PostgreSQL. Supabase is the preferred managed host, but nothing in the
# application depends on a Supabase API: Neon, RDS or a local cluster work unchanged.
# SECRET: this URL carries a password. It belongs in .env.local or a secret store.
# Use the pooled connection string and a role limited to the comments tables; the
# service-role key must never reach the browser or this application.
# Leave unset to keep comments disabled; submissions are then refused rather than
# accepted into nowhere.
COMMENTS_DATABASE_URL=replace-with-postgres-connection-url
# Defaults to TLS for any non-loopback host. Set false only for a local cluster.
# COMMENTS_DATABASE_SSL=true
# SECRET. Keys the HMAC that derives an author key from a visitor address, so no raw
# IP address is ever stored. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
COMMENTS_ABUSE_SECRET=replace-with-a-fresh-32-byte-base64url-key

# --- Comment moderation (src/lib/comments/staff-auth.ts) ---
# Comma-separated immutable numeric GitHub user IDs, not logins. The moderation API
# verifies the caller's token against GitHub on every privileged request and also
# requires write access on CMS_GITHUB_REPOSITORY above, so revoking repository
# access in GitHub revokes moderation without a deploy here.
# Read an ID with: curl -s https://api.github.com/users/LOGIN
COMMENTS_STAFF_GITHUB_USER_IDS=replace-with-numeric-staff-ids

# --- Optional public support chat ---
# All three values must be present and valid or chat remains disabled. The website
# token is a public inbox identifier, not a private Chatwoot API credential. Never
# reuse the Safaridesk inbox or token.
OPENREDAKT_CHATWOOT_ENABLED=false
# OPENREDAKT_CHATWOOT_BASE_URL=https://replace-with-the-dedicated-chatwoot-origin
# OPENREDAKT_CHATWOOT_WEBSITE_TOKEN=replace-with-the-public-website-token

# Review deployments only (for example a staging branch deploy). "true" sends
# X-Robots-Tag: noindex, nofollow on every response and makes robots.txt disallow
# all paths. Read at build time. Leave unset in production.
# SITE_NOINDEX=true
